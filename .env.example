# Azure AI Project / MCP Connection
AZURE_AI_PROJECT_ENDPOINT="https://<your-project>.services.ai.azure.com/api/projects/<project-id>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o-mini"
AI_PROJECT_RESOURCE_ID="/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<ai-project>"
AI_PROJECT_CONNECTION_NAME="rag-mcp-connection"

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
AZURE_STORAGE_CONTAINER_NAME="your-container-name"

# Azure OpenAI (Chat Model)
AZURE_OPENAI_ENDPOINT="https://your-openai-resource.openai.azure.com"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_OPENAI_MODEL_NAME="gpt-4o-mini"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"

# Embeddings (Azure OpenAI)
EMBEDDING_MODEL_NAME="text-embedding-3-large"
EMBEDDING_MODEL_DEPLOYMENT_NAME="text-embedding-3-large"

# Azure AI Search
AI_SEARCH_ENDPOINT="https://your-search-service.search.windows.net"
AI_SEARCH_KEY="your-azure-search-api-key"
AI_SEARCH_INDEX_NAME="knowledge-index"

# Azure Search Skillset
AZURE_SEARCH_SKILLSET_NAME="eduweaver-document-layout-skillset"
AZURE_SEARCH_SKILLSET_DESCRIPTION="Document Intelligence layout + embeddings"
AZURE_DOCUMENT_CHUNK_MAX_LENGTH=2000
AZURE_DOCUMENT_CHUNK_OVERLAP_LENGTH=200

# Azure Document Intelligence (Layout + Read)
AZURE_DOC_INTEL_ENDPOINT="https://your-doc-intel-resource.cognitiveservices.azure.com/"
AZURE_DOC_INTEL_KEY="your-doc-intel-key"
AZURE_DOC_INTEL_LAYOUT_MODEL_ID="prebuilt-layout"
